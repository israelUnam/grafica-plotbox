# Copie este archivo como application.properties y complete los valores.
# application.properties está en .gitignore para no versionar credenciales.

spring.application.name=graficas

# Directorio de almacenamiento de CSV
app.storage.path=./datos
app.storage.dispersion-path=./datos/dispersion

# Límites de carga multipart
spring.servlet.multipart.enabled=true
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=10MB
spring.servlet.multipart.resolve-lazily=true

spring.thymeleaf.cache=false
spring.thymeleaf.encoding=UTF-8

server.port=17006

# Soporte para proxy inverso (Nginx, Apache, Traefik con HTTPS/SSL)
server.forward-headers-strategy=framework

# =======================================================
# Google OAuth2 Credentials
# Defínalos como variables de entorno GOOGLE_CLIENT_ID y GOOGLE_CLIENT_SECRET
# o reemplace los valores por defecto.
#
# En Google Cloud Console registre como "URI de redireccionamiento autorizada":
#  - Para local:    http://localhost:17006/login/oauth2/code/google
#  - Para servidor: http://<IP_O_DOMINIO>:17006/login/oauth2/code/google (o https://... si usa SSL)
# =======================================================
spring.security.oauth2.client.registration.google.client-id=${GOOGLE_CLIENT_ID:TU_GOOGLE_CLIENT_ID}
spring.security.oauth2.client.registration.google.client-secret=${GOOGLE_CLIENT_SECRET:TU_GOOGLE_CLIENT_SECRET}
spring.security.oauth2.client.registration.google.scope=openid,profile,email
spring.security.oauth2.client.registration.google.redirect-uri={baseUrl}/login/oauth2/code/{registrationId}

# =======================================================
# Correos autorizados (separados por comas). Vacío = cualquier cuenta de Google autenticada.
# =======================================================
app.security.allowed-emails=${ALLOWED_EMAILS:}
